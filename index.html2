<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuestra Historia de Amor - Línea de Tiempo</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Fonts para estilo editorial de lujo (Playfair Display & Montserrat) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-pastel: #fdfbf7;
            --card-bg: #ffffff;
            --accent-blush: #f4e8e5;
            --accent-rose: #d4a39a;
            --accent-sage: #e3e8e5;
            --text-main: #3d3836;
            --text-muted: #7d7571;
            --timeline-line: #e2d2cd;
        }

        /* CONFIGURACIÓN DE SCROLL MODERNIZADO */
        html {
            scroll-behavior: smooth;
        }

        /* Scrollbar para WebKit (Chrome, Edge, Safari, Opera) */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(212, 163, 154, 0.4);
            border-radius: 10px;
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(212, 163, 154, 0.8);
        }

        /* Scrollbar para Firefox */
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(212, 163, 154, 0.4) transparent;
        }

        body {
            background-color: var(--bg-pastel);
            min-height: 100vh;
            font-family: 'Montserrat', sans-serif;
            color: var(--text-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* CORTINA DE CARGA INICIAL (DESVANECIMIENTO DE MEDIO TRANSPARENTE A CLARO) */
        #pageLoader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(44, 39, 37, 0.45); /* Tono oscuro medio transparente */
            backdrop-filter: blur(2px); /* Opcional: añade un sutil efecto esmerilado */
            z-index: 9999;
            transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.9s ease;
        }

        #pageLoader.fade-out {
            opacity: 0;
            visibility: hidden;
        }

        h1, h2, h3, .editorial-title {
            font-family: 'Playfair Display', serif;
        }

        .card-modern {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(74,69,67,0.06);
            padding: 2.5rem;
            width: 100%;
            max-width: 650px;
            background: var(--card-bg);
            margin: auto;
            transition: all 0.3s ease;
        }

        /* Ajuste específico para #loaderSection sin fondo ni sombra */
        #loaderSection.card-modern {
            background: transparent !important;
            box-shadow: none !important;
        }

        .hidden {
            display: none !important;
        }

        .fade-in {
            animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-control {
            border-radius: 10px;
            padding: 0.75rem 1rem;
            border: 1px solid #e0d6d0;
            background-color: #fcfbfa !important;
        }

        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(232, 215, 211, 0.4);
            border-color: var(--accent-rose);
        }

        .btn-primary {
            background-color: var(--accent-rose);
            border: none;
            border-radius: 10px;
            padding: 0.8rem;
            font-weight: 500;
            letter-spacing: 1px;
            transition: background 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #c28e85;
        }

        /* MODAL DE ERROR */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(74, 69, 67, 0.5);
            backdrop-filter: blur(5px);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.35s ease, visibility 0.35s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content-custom {
            border: none;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(74, 69, 67, 0.15);
            padding: 2.5rem;
            width: 90%;
            max-width: 440px;
            background: var(--card-bg);
            text-align: center;
            transform: scale(0.7) translateY(30px);
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        }

        .modal-overlay.active .modal-content-custom {
            transform: scale(1) translateY(0);
            opacity: 1;
        }

        .error-message-text {
            font-size: 1.15rem;
            color: var(--text-main);
            font-weight: 500;
            line-height: 1.4;
            font-family: 'Playfair Display', serif;
        }

        /* ANIMACIONES CORAZONES */
        .sad-heart-svg {
            animation: sadWobble 3s infinite ease-in-out;
            filter: drop-shadow(0px 10px 15px rgba(212, 163, 154, 0.3));
        }

        @keyframes sadWobble {
            0%, 100% { transform: rotate(0deg) translateY(0); }
            25% { transform: rotate(-3deg) translateY(3px); }
            75% { transform: rotate(3deg) translateY(3px); }
        }

        @keyframes tearDrop {
            0% { transform: translateY(0) scale(0.6); opacity: 0; }
            30% { opacity: 1; }
            100% { transform: translateY(24px) scale(1.1); opacity: 0; }
        }

        .tear-left { animation: tearDrop 1.5s infinite ease-in; }
        .tear-right { animation: tearDrop 1.5s infinite ease-in 0.4s; }

        .happy-heart-svg {
            animation: happyBeat 1.1s infinite ease-in-out alternate;
            filter: drop-shadow(0px 12px 20px rgba(212, 163, 154, 0.4));
        }

        @keyframes happyBeat {
            0% { transform: scale(0.95) rotate(-3deg); }
            100% { transform: scale(1.12) rotate(3deg); }
        }

        .floating-heart {
            animation: floatUp 2s infinite ease-out;
            opacity: 0;
        }

        .f-1 { animation-delay: 0s; }
        .f-2 { animation-delay: 0.8s; }

        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateY(-35px) scale(1.2); opacity: 0; }
        }

        .progress-bar-custom {
            background-color: var(--accent-rose) !important;
            transition: width 0.1s linear;
        }

        /* ==========================================
           ESTILOS DE LA LANDING PAGE / HERO / TIMELINE
           ========================================== */
        
        #finalSection {
            width: 100%;
            margin: 0 auto;
            display: flex;
            justify-content: center;
        }

        .landing-container {
            width: 100%;
            max-width: 1300px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem 5rem 1.5rem;
        }

        /* HEADER HERO BANNER */
        .hero-banner {
            position: relative;
            padding: 4.5rem 3.5rem;
            margin-bottom: 5rem;
            border-radius: 24px;
            background: linear-gradient(135deg, #fbf4f2 0%, #f5ece9 100%);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2.5rem;
        }

        .hero-banner-content {
            position: relative;
            z-index: 3;
            flex: 1 1 55%;
            max-width: 650px;
        }

        .hero-tag {
            display: inline-block;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #b08982;
            font-weight: 600;
            margin-bottom: 1rem;
            background-color: rgba(255, 255, 255, 0.75);
            padding: 0.4rem 1.2rem;
            border-radius: 50px;
        }

        .hero-title {
            font-size: 3.8rem;
            font-weight: 700;
            line-height: 1.15;
            color: #2c2725;
            margin-bottom: 1.5rem;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 0;
        }

        .hero-visual {
            position: relative;
            flex: 1 1 40%;
            height: 380px;
            z-index: 2;
        }

        .hero-img-main {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(74, 69, 67, 0.12);
            position: relative;
            z-index: 2;
        }

        .hero-shape-backdrop {
            position: absolute;
            top: -15px;
            right: -15px;
            width: 100%;
            height: 100%;
            background-color: var(--accent-rose);
            opacity: 0.25;
            border-radius: 20px;
            z-index: 1;
        }

        /* LÍNEA DE TIEMPO CON CONECTORES */
        .timeline-wrapper {
            position: relative;
            padding: 2rem 0;
        }

        .timeline-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            background: linear-gradient(to bottom, transparent, var(--accent-rose) 15%, var(--timeline-line) 85%, transparent);
            transform: translateX(-50%);
            z-index: 1;
        }

        .timeline-block {
            display: flex;
            align-items: center;
            gap: 5rem;
            margin-bottom: 6rem;
            position: relative;
            z-index: 2;
        }

        .timeline-block:nth-child(even) {
            flex-direction: row-reverse;
        }

        .timeline-node {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 36px;
            height: 36px;
            background-color: var(--accent-blush);
            border-radius: 50%;
            z-index: 4;
            box-shadow: 0 0 0 6px var(--bg-pastel);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .heart-icon {
            width: 18px;
            height: 18px;
            color: #b08982;
            margin-top: 1px;
        }

        .timeline-content {
            flex: 1;
            background: var(--card-bg);
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(74, 69, 67, 0.04);
            border: 1px solid #f2ece9;
        }

        .timeline-block:nth-child(odd) .timeline-content {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            border-top-left-radius: 18px;
            border-bottom-left-radius: 18px;
        }

        .timeline-block:nth-child(even) .timeline-content {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: 18px;
            border-bottom-right-radius: 18px;
        }

        .timeline-date-badge {
            display: inline-block;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #b08982;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }

        .timeline-title {
            font-size: 2.2rem;
            font-weight: 600;
            color: #3b3533;
            margin-bottom: 1rem;
            line-height: 1.25;
        }

        .timeline-desc {
            color: var(--text-muted);
            font-size: 1.02rem;
            line-height: 1.7;
            margin: 0;
        }

        .timeline-image-wrapper {
            flex: 1;
            position: relative;
        }

        .timeline-image-wrapper::before {
            content: '';
            position: absolute;
            width: 90%;
            height: 90%;
            background-color: var(--accent-blush);
            top: -14px;
            left: -14px;
            z-index: 1;
            border-radius: 16px;
            opacity: 0.7;
        }

        .timeline-block:nth-child(even) .timeline-image-wrapper::before {
            left: auto;
            right: -14px;
            background-color: var(--accent-sage);
        }

        .timeline-img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 16px;
            position: relative;
            z-index: 2;
            box-shadow: 0 15px 35px rgba(74, 69, 67, 0.08);
        }

        /* RESPONSIVE DESIGN */
        @media (max-width: 991px) {
            .hero-banner {
                padding: 3rem 1.5rem;
                text-align: center;
                flex-direction: column;
                gap: 2rem;
            }
            .hero-banner-content {
                max-width: 100%;
                flex: none;
            }
            .hero-title {
                font-size: 2.6rem;
            }
            .hero-visual {
                width: 100%;
                height: 300px;
                flex: none;
            }
            .timeline-wrapper::before {
                left: 20px;
            }
            .timeline-node {
                left: 20px;
            }
            .timeline-block, .timeline-block:nth-child(even) {
                flex-direction: column;
                gap: 1.5rem;
                padding-left: 50px;
                margin-bottom: 4rem;
            }
            
            .timeline-block:nth-child(odd) .timeline-content,
            .timeline-block:nth-child(even) .timeline-content {
                border-top-left-radius: 0;
                border-bottom-left-radius: 0;
                border-top-right-radius: 18px;
                border-bottom-right-radius: 18px;
            }

            .timeline-image-wrapper {
                width: 100%;
            }
            .timeline-img {
                height: 280px;
            }
        }

        @media (max-width: 576px) {
            .hero-title {
                font-size: 2.1rem;
            }
            .timeline-content {
                padding: 1.5rem;
            }
            .timeline-title {
                font-size: 1.6rem;
            }
            .timeline-img {
                height: 220px;
            }
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

    <!-- Cortina de carga inicial (Desvanecimiento desde un tono semitransparente) -->
    <div id="pageLoader"></div>

    <!-- Contenedor Centrado Inicial para Presentación, Cuestionario y Loader -->
    <div id="initialContainer" class="container d-flex justify-content-center align-items-center min-vh-100">
        
        <!-- Sección de Presentación / Bienvenida Inicial -->
        <div id="introSection" class="card-modern text-center fade-in">
            <div class="mb-3 position-relative d-inline-block">
                <svg class="happy-heart-svg" viewBox="0 0 100 100" width="130" height="130">
                    <path class="floating-heart f-1" d="M 15 25 C 11 21, 5 23, 5 28 C 5 33, 15 39, 15 39 C 15 39, 25 33, 25 28 C 25 23, 19 21, 15 25 Z" fill="#d4a39a"/>
                    <path class="floating-heart f-2" d="M 85 25 C 81 21, 75 23, 75 28 C 75 33, 85 39, 85 39 C 85 39, 95 33, 95 28 C 95 23, 89 21, 85 25 Z" fill="#d4a39a"/>
                    <path d="M 50 88 C 20 65, 5 45, 5 28 C 5 13, 16 3, 31 3 C 40 3, 47 8, 50 14 C 53 8, 60 3, 69 3 C 84 3, 95 13, 95 28 C 95 45, 80 65, 50 88 Z" fill="#d4a39a"/>
                    <path d="M 33 37 C 30 33, 25 35, 25 39 C 25 43, 33 48, 33 48 C 33 48, 41 43, 41 39 C 41 35, 36 33, 33 37 Z" fill="#ffffff"/>
                    <path d="M 67 37 C 64 33, 59 35, 59 39 C 59 43, 67 48, 67 48 C 67 48, 75 43, 75 39 C 75 35, 70 33, 67 37 Z" fill="#ffffff"/>
                    <path d="M 36 53 Q 50 67 64 53" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none"/>
                    <ellipse cx="23" cy="50" rx="6" ry="3.5" fill="#f4acb7" opacity="0.8"/>
                    <ellipse cx="77" cy="50" rx="6" ry="3.5" fill="#f4acb7" opacity="0.8"/>
                </svg>
            </div>
            
            <span class="hero-tag mb-2">Un Viaje Inolvidable</span>
            <h1 class="editorial-title fw-bold text-dark mb-3" style="font-size: 2.4rem;">Nuestra Historia de Amor</h1>
            <p class="text-muted mb-4" style="font-size: 1.05rem; line-height: 1.6;">Te invitamos a revivir los momentos más especiales que han construido este hermoso camino juntos.</p>
            
            <button id="startIntroBtn" class="btn btn-primary w-100 py-3 shadow-sm" style="font-size: 1rem;">Comenzar Recorrido</button>
        </div>

        <!-- Sección del Cuestionario (Oculto inicialmente) -->
        <div id="quizSection" class="card-modern hidden">
            <h2 class="text-center mb-3 fw-bold text-dark editorial-title" style="font-size: 2rem;">Validación de Identidad</h2>
            <p class="text-muted text-center mb-4" style="font-size: 0.95rem;">Por favor, responde correctamente a las siguientes preguntas seleccionando la fecha correspondiente para poder avanzar.</p>

            <form id="quizForm">
                <div class="mb-3">
                    <label for="q1" class="form-label fw-medium text-secondary small">1. ¿Cuál es tu fecha de nacimiento?</label>
                    <input type="date" class="form-control" id="q1" required>
                </div>
                
                <div class="mb-3">
                    <label for="q2" class="form-label fw-medium text-secondary small">2. ¿Cuál es la fecha de tu graduación?</label>
                    <input type="date" class="form-control" id="q2" required>
                </div>

                <div class="mb-3">
                    <label for="q3" class="form-label fw-medium text-secondary small">3. ¿Cuál es la fecha de tu primer empleo?</label>
                    <input type="date" class="form-control" id="q3" required>
                </div>

                <div class="mb-3">
                    <label for="q4" class="form-label fw-medium text-secondary small">4. ¿Cuál es la fecha de compra de tu primer coche?</label>
                    <input type="date" class="form-control" id="q4" required>
                </div>

                <div class="mb-4">
                    <label for="q5" class="form-label fw-medium text-secondary small">5. ¿Cuál es la fecha de tu boda?</label>
                    <input type="date" class="form-control" id="q5" required>
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-2 shadow-sm">Validar Respuestas</button>
            </form>
        </div>

        <!-- Sección de Carga -->
        <div id="loaderSection" class="card-modern hidden text-center">
            <div class="mb-3 position-relative d-inline-block">
                <svg class="happy-heart-svg" viewBox="0 0 100 100" width="130" height="130">
                    <path class="floating-heart f-1" d="M 15 25 C 11 21, 5 23, 5 28 C 5 33, 15 39, 15 39 C 15 39, 25 33, 25 28 C 25 23, 19 21, 15 25 Z" fill="#d4a39a"/>
                    <path class="floating-heart f-2" d="M 85 25 C 81 21, 75 23, 75 28 C 75 33, 85 39, 85 39 C 85 39, 95 33, 95 28 C 95 23, 89 21, 85 25 Z" fill="#d4a39a"/>
                    <path d="M 50 88 C 20 65, 5 45, 5 28 C 5 13, 16 3, 31 3 C 40 3, 47 8, 50 14 C 53 8, 60 3, 69 3 C 84 3, 95 13, 95 28 C 95 45, 80 65, 50 88 Z" fill="#d4a39a"/>
                    <path d="M 33 37 C 30 33, 25 35, 25 39 C 25 43, 33 48, 33 48 C 33 48, 41 43, 41 39 C 41 35, 36 33, 33 37 Z" fill="#ffffff"/>
                    <path d="M 67 37 C 64 33, 59 35, 59 39 C 59 43, 67 48, 67 48 C 67 48, 75 43, 75 39 C 75 35, 70 33, 67 37 Z" fill="#ffffff"/>
                    <path d="M 36 53 Q 50 67 64 53" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none"/>
                    <ellipse cx="23" cy="50" rx="6" ry="3.5" fill="#f4acb7" opacity="0.8"/>
                    <ellipse cx="77" cy="50" rx="6" ry="3.5" fill="#f4acb7" opacity="0.8"/>
                </svg>
            </div>

            <h3 class="fw-bold text-dark mb-2 editorial-title">¡Respuestas Correctas!</h3>
            <p class="text-muted mb-4 small">Preparando nuestra hermosa línea del tiempo...</p>

            <div class="progress rounded-pill mb-2" style="height: 8px; background-color: #f2e9e4;">
                <div id="progressBar" class="progress-bar progress-bar-custom rounded-pill" role="progressbar" style="width: 0%;"></div>
            </div>
        </div>

    </div>

    <!-- Sección de la Página Final: Landing Page / Hero Banner / Timeline Estilo Editorial -->
    <div id="finalSection" class="hidden">
        <div class="landing-container fade-in">
            
            <!-- Hero Banner de Gran Impacto -->
            <header class="hero-banner shadow-sm">
                <div class="hero-banner-content">
                    <span class="hero-tag">El Comienzo de Todo</span>
                    <h1 class="hero-title">Nuestra Historia en el Tiempo</h1>
                    <p class="hero-subtitle">Cada paso, cada logro y cada decisión nos guiaron hasta este preciso instante. Bienvenido a un recorrido cronológico por los momentos que cambiaron nuestras vidas para siempre.</p>
                </div>
                
                <div class="hero-visual">
                    <div class="hero-shape-backdrop"></div>
                    <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=800&q=80" alt="Nuestra Historia" class="hero-img-main">
                </div>
            </header>

            <!-- Contenedor del Timeline con Línea Continua -->
            <div class="timeline-wrapper">

                <!-- Hito 1: Nacimiento -->
                <div class="timeline-block">
                    <div class="timeline-node">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <div class="timeline-content">
                        <span class="timeline-date-badge">25 de Marzo, 2000</span>
                        <h2 class="timeline-title">El Comienzo de la Vida</h2>
                        <p class="timeline-desc">El día en que dio inicio esta maravillosa travesía. Una fecha mágica que marcó el nacimiento de alguien extraordinario, llenando de luz, alegría y esperanza el mundo entero.</p>
                    </div>
                    <div class="timeline-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80" alt="Nacimiento / Infancia" class="timeline-img">
                    </div>
                </div>

                <!-- Hito 2: Graduación -->
                <div class="timeline-block">
                    <div class="timeline-node">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <div class="timeline-content">
                        <span class="timeline-date-badge">16 de Noviembre, 2018</span>
                        <h2 class="timeline-title">La Graduación</h2>
                        <p class="timeline-desc">La feliz culminación de años de esfuerzo, desvelos y dedicación. Este logro reafirmó la capacidad de alcanzar cualquier meta y abrió la puerta hacia un horizonte profesional brillante.</p>
                    </div>
                    <div class="timeline-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=800&q=80" alt="Graduación" class="timeline-img">
                    </div>
                </div>

                <!-- Hito 3: Primer Empleo -->
                <div class="timeline-block">
                    <div class="timeline-node">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <div class="timeline-content">
                        <span class="timeline-date-badge">22 de Enero, 2020</span>
                        <h2 class="timeline-title">El Primer Empleo</h2>
                        <p class="timeline-desc">El primer gran paso en el mundo profesional. Los nervios del inicio, los aprendizajes diarios y la enorme satisfacción de cosechar los frutos del propio trabajo con independencia.</p>
                    </div>
                    <div class="timeline-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=800&q=80" alt="Primer Empleo" class="timeline-img">
                    </div>
                </div>

                <!-- Hito 4: Primer Coche -->
                <div class="timeline-block">
                    <div class="timeline-node">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <div class="timeline-content">
                        <span class="timeline-date-badge">20 de Julio, 2022</span>
                        <h2 class="timeline-title">El Primer Coche</h2>
                        <p class="timeline-desc">La maravillosa conquista de la libertad y nuevos caminos por recorrer. Tomar las llaves del primer auto simbolizó incontables viajes espontáneos y momentos inolvidables en la carretera.</p>
                    </div>
                    <div class="timeline-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=800&q=80" alt="Primer Coche" class="timeline-img">
                    </div>
                </div>

                <!-- Hito 5: La Boda -->
                <div class="timeline-block">
                    <div class="timeline-node">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <div class="timeline-content">
                        <span class="timeline-date-badge">11 de Mayo, 2024</span>
                        <h2 class="timeline-title">Nuestra Boda</h2>
                        <p class="timeline-desc">El día más romántico y sublime de todos. Rodeados de quienes más amamos, unimos nuestras vidas para siempre, prometiendo caminar juntos en complicidad, respeto y amor infinito.</p>
                    </div>
                    <div class="timeline-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80" alt="Nuestra Boda" class="timeline-img">
                    </div>
                </div>

            </div>

            <!-- Footer Editorial -->
            <footer class="text-center pt-5 pb-4 border-top mt-5" style="border-color: #e8d7d3 !important;">
                <p class="text-muted small mb-0 font-italic" style="font-family: 'Playfair Display', serif; font-size: 1.2rem;">"Cada instante del pasado valió la pena para llegar a este maravilloso presente."</p>
            </footer>

        </div>
    </div>

    <!-- Modal de Error Personalizado (Sad Heart) -->
    <div id="errorModal" class="modal-overlay">
        <div class="modal-content-custom">
            <div class="mb-3">
                <svg class="sad-heart-svg" viewBox="0 0 100 100" width="120" height="120">
                    <path d="M 50 88 C 20 65, 5 45, 5 28 C 5 13, 16 3, 31 3 C 40 3, 47 8, 50 14 C 53 8, 60 3, 69 3 C 84 3, 95 13, 95 28 C 95 45, 80 65, 50 88 Z" fill="#e8d7d3"/>
                    <circle cx="34" cy="38" r="4.5" fill="#4a4543"/>
                    <circle cx="66" cy="38" r="4.5" fill="#4a4543"/>
                    <circle cx="35.5" cy="36.5" r="1.5" fill="#ffffff"/>
                    <circle cx="67.5" cy="36.5" r="1.5" fill="#ffffff"/>
                    <path d="M 26 30 Q 34 33 40 30" stroke="#4a4543" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    <path d="M 74 30 Q 66 33 60 30" stroke="#4a4543" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    <path d="M 42 54 Q 50 47 58 54" stroke="#4a4543" stroke-width="3" stroke-linecap="round" fill="none"/>
                    <ellipse cx="26" cy="45" rx="5" ry="3" fill="#d4a39a" opacity="0.4"/>
                    <ellipse cx="74" cy="45" rx="5" ry="3" fill="#d4a39a" opacity="0.4"/>
                    <path class="tear-left" d="M 32 45 C 30 49, 30 53, 32 55 C 34 55, 35 52, 32 45 Z" fill="#90e0ef"/>
                    <path class="tear-right" d="M 68 45 C 66 49, 66 53, 68 55 C 70 55, 71 52, 68 45 Z" fill="#90e0ef"/>
                </svg>
            </div>
            <p id="errorMessageText" class="error-message-text mb-4"></p>
            <button id="closeModalBtn" class="btn btn-outline-secondary w-100 py-2 fw-medium rounded-3" style="border-color: #d4a39a; color: #4a4543;">Intentar de nuevo</button>
        </div>
    </div>

    <!-- JavaScript de Control -->
    <script>
        // Desvanecer la cortina de carga inicial al cargar la página
        window.addEventListener('load', function() {
            const pageLoader = document.getElementById('pageLoader');
            setTimeout(() => {
                pageLoader.classList.add('fade-out');
            }, 200);
        });

        const errorMessages = [
            "¡No puedo creer que no te sepas las fechas!",
            "¿En serio? ¡Son fechas super importantes!",
            "¡Mi corazoncito se ha roto de la tristeza!",
            "¿Te has olvidado de todo? Piénsalo bien...",
            "¡Ay no! Alguna de las fechas no coincide.",
            "¿Seguro que colocaste las fechas correctas?"
        ];

        // Transición de la presentación inicial al cuestionario
        document.getElementById('startIntroBtn').addEventListener('click', function() {
            const introSection = document.getElementById('introSection');
            const quizSection = document.getElementById('quizSection');

            introSection.classList.add('hidden');
            quizSection.classList.remove('hidden');
            quizSection.classList.add('fade-in');
        });

        document.getElementById('quizForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const correctAnswers = {
                q1: '2000-03-25',
                q2: '2018-11-16',
                q3: '2020-01-22',
                q4: '2022-07-20',
                q5: '2024-05-11'
            };

            const userAnswers = {
                q1: document.getElementById('q1').value,
                q2: document.getElementById('q2').value,
                q3: document.getElementById('q3').value,
                q4: document.getElementById('q4').value,
                q5: document.getElementById('q5').value
            };

            const initialContainer = document.getElementById('initialContainer');
            const quizSection = document.getElementById('quizSection');
            const loaderSection = document.getElementById('loaderSection');
            const finalSection = document.getElementById('finalSection');
            const errorModal = document.getElementById('errorModal');
            const errorMessageText = document.getElementById('errorMessageText');

            if (userAnswers.q1 === correctAnswers.q1 &&
                userAnswers.q2 === correctAnswers.q2 &&
                userAnswers.q3 === correctAnswers.q3 &&
                userAnswers.q4 === correctAnswers.q4 &&
                userAnswers.q5 === correctAnswers.q5) {
                
                quizSection.classList.add('hidden');
                loaderSection.classList.remove('hidden');
                loaderSection.classList.add('fade-in');

                let progress = 0;
                const progressBar = document.getElementById('progressBar');

                const interval = setInterval(() => {
                    progress += 2;
                    progressBar.style.width = progress + '%';

                    if (progress >= 100) {
                        clearInterval(interval);
                        initialContainer.classList.add('hidden');
                        document.body.classList.remove('d-flex', 'align-items-center', 'justify-content-center');
                        finalSection.classList.remove('hidden');
                        window.scrollTo(0, 0);
                    }
                }, 100);

            } else {
                const randomMessage = errorMessages[Math.floor(Math.random() * errorMessages.length)];
                errorMessageText.innerText = randomMessage;
                errorModal.classList.add('active');
            }
        });

        function closeModal() {
            document.getElementById('errorModal').classList.remove('active');
        }

        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('errorModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    </script>
</body>
</html>
